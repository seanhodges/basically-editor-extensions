# Sources — only the compiled output in out/ ships
src/**
**/*.ts

# Build configuration
tsconfig.json
.eslintrc*
.editorconfig
.gitignore
.vscodeignore

# Tests
**/*.test.js
**/*.test.js.map
test/**
**/__tests__/**
.vscode-test/**

# Source maps and tooling noise
**/*.map
node_modules/**
**/.DS_Store
**/*.log

# The toolchain ships inside the VSIX, its own LICENSE and README beside it:
# the VSIX carries a GPL-3.0-or-later program and must say so. The emulator it
# resolves before running any machine travels with it, under its own licence,
# and is re-included explicitly because `node_modules/**` above would drop it.
!server/**
!server/node_modules/**

# Two accounts of modules, and they are about different trees. `node_modules/**`
# above is the workspace's, which `clients/*` being a workspace glob hoists to
# the repository root and which is no part of this package — the packager
# excludes it before this file is consulted either way, so nothing here could
# re-include it. What the client actually loads travels in out/node_modules/,
# put there by scripts/vendor-modules.mjs beside the compiled client that
# requires it, and matches none of the patterns above. Nothing to add here;
# this is written down so that the next person to look does not add it.
