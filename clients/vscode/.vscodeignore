# Sources — only the compiled output in out/ ships
src/**
**/*.ts
!out/**/*.d.ts

# Build configuration
tsconfig.json
.eslintrc*
.editorconfig
.gitignore
.vscodeignore

# Tests
**/*.test.js
**/*.test.js.map
test/**
**/__tests__/**
.vscode-test/**

# Source maps and tooling noise
**/*.map
node_modules/**
**/.DS_Store
**/*.log

# The language server ships inside the VSIX, its own LICENSE and README beside
# it: the VSIX carries a GPL-3.0-or-later program and must say so.
!server/**
