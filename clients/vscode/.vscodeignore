# Sources — only the compiled output in out/ ships
src/**
**/*.ts
!out/**/*.d.ts

# Build configuration
tsconfig.json
.eslintrc*
.editorconfig
.gitignore
.vscodeignore

# Tests
**/*.test.js
**/*.test.js.map
test/**
**/__tests__/**
.vscode-test/**

# Source maps and tooling noise
**/*.map
node_modules/**
**/.DS_Store
**/*.log

# The toolchain ships inside the VSIX, its own LICENSE and README beside it:
# the VSIX carries a GPL-3.0-or-later program and must say so. The emulator it
# resolves before running any machine travels with it, under its own licence,
# and is re-included explicitly because `node_modules/**` above would drop it.
!server/**
!server/node_modules/**
